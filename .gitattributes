# Committed Vite output must check out byte-identically (LF) regardless of
# core.autocrlf so that `npm run verify:dist` rebuilds and compares cleanly.
# The source `ui/index.html` is the verbatim Vite entry; it must also check out
# as LF so a clean Windows checkout rebuilds byte-identical LF output.
/tools/stm32-monitor/src/stm32_monitor/ui_dist/** text eol=lf
/tools/stm32-monitor/ui/index.html text eol=lf
/tools/release/licenses/** text eol=lf
/LICENSE text eol=lf
# Canonical SPDX authority preserves upstream trailing-space/blank-EOF bytes.
/tools/release/licenses/spdx/** whitespace=-trailing-space
/tools/stm32-toolkit/tests/release/fixtures/native-outcomes/** text eol=lf
/tools/stm32-toolkit/tests/fixtures/component-admission/target-transports/** text eol=lf
/tools/stm32-toolkit/tests/fixtures/target-streams/*.json text eol=lf
/tools/stm32-toolkit/tests/fixtures/target-streams/*.bin -text
/tools/stm32-toolkit/tests/fixtures/vs03/target/*.json text eol=lf
/tools/stm32-toolkit/tests/fixtures/vs03/target/*.hex text eol=lf
/tools/stm32-monitor/tests/fixtures/vs03/*.json text eol=lf
