{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stm32-toolkit.dev/schemas/stm32-project.schema.json",
  "title": "STM32 Toolkit Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "logicalProjectId",
    "generatedBy",
    "project",
    "target",
    "framework",
    "build",
    "memory",
    "debug",
    "generation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "logicalProjectId": {
      "type": "string",
      "format": "uuid"
    },
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "origin"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "core"],
      "properties": {
        "device": {"type": "string", "minLength": 1},
        "core": {"type": "string", "minLength": 1},
        "fpu": {"type": "string", "minLength": 1},
        "floatAbi": {"type": "string", "minLength": 1},
        "devicePack": {"type": "string", "minLength": 1}
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {
        "type": {
          "enum": ["spl", "hal", "ll", "cmsis", "bare-metal"]
        },
        "version": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "includePaths",
        "defines",
        "compileOptions",
        "assemblySources",
        "presets"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "includePaths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "defines": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "compileOptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "assemblySources": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "presets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "elf": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "regions"],
      "properties": {
        "source": {
          "enum": ["keil", "cubemx", "manual"]
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "origin", "length", "attributes"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "origin": {"type": "integer", "minimum": 0},
              "length": {"type": "integer", "minimum": 1},
              "attributes": {
                "enum": ["r--", "rw-", "r-x", "rwx"]
              }
            }
          }
        }
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "svd": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cubeMxIoc",
        "managedManifest",
        "generatedDirectories",
        "userDirectories"
      ],
      "properties": {
        "cubeMxIoc": {"type": ["string", "null"], "minLength": 1},
        "managedManifest": {"type": "string", "minLength": 1},
        "generatedDirectories": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "userDirectories": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["buildPreset", "ctestPreset", "labels", "timeout_seconds", "environment"],
          "properties": {
            "buildPreset": {"type": "string", "minLength": 1, "maxLength": 128, "description": "NFC and the 128 UTF-8 byte limit are enforced by the model layer."},
            "ctestPreset": {"type": "string", "minLength": 1, "maxLength": 128, "description": "NFC and the 128 UTF-8 byte limit are enforced by the model layer."},
            "labels": {
              "type": "array",
              "maxItems": 32,
              "items": {"type": "string", "minLength": 1, "maxLength": 128, "description": "NFC and the 128 UTF-8 byte limit are enforced by the model layer."},
              "uniqueItems": true
            },
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "environment": {
              "type": "object",
              "additionalProperties": false,
              "required": ["allow", "values"],
              "properties": {
                "allow": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "uniqueItems": true
                },
                "values": {
                  "type": "object",
                  "maxProperties": 32,
                  "propertyNames": {"maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                  "additionalProperties": {"type": "string", "maxLength": 4096, "description": "NFC and the 4096 UTF-8 byte limit are enforced by the model layer."}
                }
              }
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "timeout_seconds", "transport"],
          "properties": {
            "executable": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$", "description": "Must resolve within the real canonical workspace; link/reparse containment and UTF-8/NFC checks are enforced by the model layer."},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "transport": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "options"],
              "properties": {
                "kind": {"enum": ["memory-mailbox", "rtt", "uart", "semihosting"]},
                "options": {"type": "object"}
              },
              "allOf": [
                {
                  "if": {"properties": {"kind": {"const": "memory-mailbox"}}},
                  "then": {
                    "properties": {
                      "options": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["address", "size"],
                        "properties": {
                          "address": {"type": "integer", "minimum": 0, "maximum": 4294967295},
                          "size": {"type": "integer", "minimum": 1, "maximum": 65536}
                        }
                      }
                    }
                  }
                },
                {
                  "if": {"properties": {"kind": {"const": "rtt"}}},
                  "then": {
                    "properties": {
                      "options": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["channel"],
                        "properties": {
                          "channel": {"type": "integer", "minimum": 0, "maximum": 15},
                          "controlBlockAddress": {"type": "integer", "minimum": 0, "maximum": 4294967295}
                        }
                      }
                    }
                  }
                },
                {
                  "if": {"properties": {"kind": {"const": "uart"}}},
                  "then": {
                    "properties": {
                      "options": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["port", "baud"],
                        "properties": {
                          "port": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256,
                            "description": "NFC and the 256 UTF-8 byte limit are enforced by the model layer.",
                            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
                          },
                          "baud": {
                            "type": "integer",
                            "enum": [9600, 19200, 38400, 57600, 115200, 230400, 460800, 921600]
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {"properties": {"kind": {"const": "semihosting"}}},
                  "then": {
                    "properties": {
                      "options": {"type": "object", "additionalProperties": false}
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "anyOf": [{"required": ["host"]}, {"required": ["target"]}]
    }
  }
}
