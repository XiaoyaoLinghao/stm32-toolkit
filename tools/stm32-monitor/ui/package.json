{
  "name": "stm32-monitor-ui",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:check": "node tests/check-coverage.mjs",
    "test:a11y": "vitest run tests/a11y.test.tsx",
    "build": "vite build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:e2e:windows": "playwright test",
    "test:e2e:performance": "playwright test e2e/performance.spec.ts"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.1",
    "@types/jsdom": "27.0.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.11.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "27.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}