{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stm32-toolkit.dev/schemas/probe-protocol.schema.json",
  "title": "STM32 Toolkit Probe Service request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "toolkitVersion",
    "requestId",
    "workspaceId",
    "sessionId",
    "leaseId",
    "operationLevel",
    "operation",
    "timeoutMs",
    "data"
  ],
  "properties": {
    "protocol": {"const": "stm32-toolkit-probe/2"},
    "toolkitVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "requestId": {"$ref": "#/$defs/identifier"},
    "workspaceId": {"$ref": "#/$defs/identifier"},
    "sessionId": {"$ref": "#/$defs/identifier"},
    "leaseId": {"$ref": "#/$defs/identifier"},
    "operationLevel": {"enum": ["observe", "control", "modify"]},
    "operation": {
      "enum": ["probe.list", "probe.attach", "memory.read", "register.read", "probe.close", "flash.program", "target.transport.open", "target.transport.read", "target.transport.close", "target.identity.read", "target.state.read", "target.halt", "target.resume", "target.step", "target.breakpoint.set", "target.breakpoint.clear", "target.registers.read", "target.memory.read", "target.fault.capture", "target.logs.capture"]
    },
    "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 300000},
    "data": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "memory.read"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "length"],
            "properties": {
              "address": {"type": "integer", "minimum": 0, "maximum": 4294967295},
              "length": {"type": "integer", "minimum": 1, "maximum": 65536}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "register.read"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["names"],
            "properties": {
              "names": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"enum": ["probe.list", "probe.close"]}
        }
      },
      "then": {
        "properties": {
          "data": {"type": "object", "maxProperties": 0}
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "probe.attach"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["probeId", "target"],
            "properties": {
              "probeId": {"$ref": "#/$defs/identifier"},
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "flash.program"}}},
      "then": {
        "properties": {
          "operationLevel": {"const": "modify"},
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["elfPath", "elfSha256", "elfSize"],
            "properties": {
              "elfPath": {
                "type": "string",
                "minLength": 5,
                "maxLength": 1024,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.elf$"
              },
              "elfSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "elfSize": {"type": "integer", "minimum": 1, "maximum": 67108864}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "target.transport.open"}}},
      "then": {"properties": {"operationLevel": {"const": "observe"}, "data": {"type": "object", "additionalProperties": false, "required": ["transport", "config", "deadline_ms"], "properties": {"transport": {"enum": ["mailbox", "rtt", "uart", "semihosting"]}, "config": {"type": "object"}, "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 300000}}}}}
    },
    {
      "if": {"properties": {"operation": {"const": "target.transport.read"}}},
      "then": {"properties": {"operationLevel": {"const": "observe"}, "data": {"type": "object", "additionalProperties": false, "required": ["transport_id", "max_bytes", "deadline_ms"], "properties": {"transport_id": {"$ref": "#/$defs/identifier"}, "max_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}, "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 300000}}}}}
    },
    {
      "if": {"properties": {"operation": {"const": "target.transport.close"}}},
      "then": {"properties": {"operationLevel": {"const": "observe"}, "data": {"type": "object", "additionalProperties": false, "required": ["transport_id"], "properties": {"transport_id": {"$ref": "#/$defs/identifier"}}}}}
    },
    {
      "if": {"properties": {"operation": {"enum": ["target.identity.read", "target.state.read"]}}},
      "then": {"properties": {"operationLevel": {"const": "observe"}, "data": {"type": "object", "maxProperties": 0}}}
    },
    {
      "if": {"properties": {"operation": {"enum": ["target.halt", "target.resume", "target.step"]}}},
      "then": {"properties": {"operationLevel": {"const": "control"}, "data": {"type": "object", "additionalProperties": false, "required": ["authorization"], "properties": {"authorization": {"$ref": "#/$defs/digest"}}}}}
    },
    {
      "if": {"properties": {"operation": {"const": "target.step"}}},
      "then": {"properties": {"timeoutMs": {"type": "integer", "minimum": 1, "maximum": 5000}}}
    },
    {
      "if": {"properties": {"operation": {"const": "target.breakpoint.set"}}},
      "then": {"properties": {"operationLevel": {"const": "control"}, "data": {"type": "object", "additionalProperties": false, "required": ["address", "kind", "size", "authorization"], "properties": {"address": {"$ref": "#/$defs/u32"}, "kind": {"const": "temporary"}, "size": {"enum": [1, 2, 4]}, "authorization": {"$ref": "#/$defs/digest"}}}}}
    },
    {
      "if": {"properties": {"operation": {"const": "target.breakpoint.clear"}}},
      "then": {"properties": {"operationLevel": {"const": "control"}, "data": {"type": "object", "additionalProperties": false, "required": ["breakpoint_id", "authorization"], "properties": {"breakpoint_id": {"$ref": "#/$defs/identifier"}, "authorization": {"$ref": "#/$defs/digest"}}}}}
    },
    {
      "if": {"properties": {"operation": {"const": "target.registers.read"}}},
      "then": {"properties": {"operationLevel": {"const": "observe"}, "data": {"type": "object", "additionalProperties": false, "required": ["names"], "properties": {"names": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"}}}}}}
    },
    {
      "if": {"properties": {"operation": {"const": "target.memory.read"}}},
      "then": {"properties": {"operationLevel": {"const": "observe"}, "data": {"type": "object", "additionalProperties": false, "required": ["address", "length"], "properties": {"address": {"$ref": "#/$defs/u32"}, "length": {"type": "integer", "minimum": 1, "maximum": 4096}}}}}
    },
    {
      "if": {"properties": {"operation": {"const": "target.fault.capture"}}},
      "then": {"properties": {"operationLevel": {"const": "observe"}, "data": {"type": "object", "additionalProperties": false, "required": ["max_stack_bytes"], "properties": {"max_stack_bytes": {"type": "integer", "minimum": 0, "maximum": 4096}}}}}
    },
    {
      "if": {"properties": {"operation": {"const": "target.logs.capture"}}},
      "then": {"properties": {"operationLevel": {"const": "observe"}, "data": {"type": "object", "additionalProperties": false, "required": ["channel", "max_bytes", "duration_ms"], "properties": {"channel": {"enum": ["rtt", "uart", "semihosting", "swo", "probe"]}, "max_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760}, "duration_ms": {"type": "integer", "minimum": 1, "maximum": 300000}}}}}
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295}
  }
}
