{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stm32-toolkit.dev/schemas/stm32-project.schema.json",
  "title": "STM32 Toolkit Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "logicalProjectId",
    "generatedBy",
    "project",
    "target",
    "framework",
    "build",
    "memory",
    "debug",
    "generation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "logicalProjectId": {
      "type": "string",
      "format": "uuid"
    },
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "origin"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "core"],
      "properties": {
        "device": {"type": "string", "minLength": 1},
        "core": {"type": "string", "minLength": 1},
        "fpu": {"type": "string", "minLength": 1},
        "floatAbi": {"type": "string", "minLength": 1},
        "devicePack": {"type": "string", "minLength": 1}
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {
        "type": {
          "enum": ["spl", "hal", "ll", "cmsis", "bare-metal"]
        },
        "version": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "includePaths",
        "defines",
        "compileOptions",
        "assemblySources",
        "presets"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "includePaths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "defines": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "compileOptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "assemblySources": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "presets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "elf": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "regions"],
      "properties": {
        "source": {
          "enum": ["keil", "cubemx", "manual"]
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "origin", "length", "attributes"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "origin": {"type": "integer", "minimum": 0},
              "length": {"type": "integer", "minimum": 1},
              "attributes": {
                "enum": ["r--", "rw-", "r-x", "rwx"]
              }
            }
          }
        }
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "svd": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cubeMxIoc",
        "managedManifest",
        "generatedDirectories",
        "userDirectories"
      ],
      "properties": {
        "cubeMxIoc": {"type": ["string", "null"], "minLength": 1},
        "managedManifest": {"type": "string", "minLength": 1},
        "generatedDirectories": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "userDirectories": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
