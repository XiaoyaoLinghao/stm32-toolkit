ENTRY(Reset_Handler)

_Min_Heap_Size = {{ heap_size_literal }};
_Min_Stack_Size = {{ stack_size_literal }};

MEMORY
{
{%- for region in regions %}
  {{ region.name }} ({{ region.attributes }}) : ORIGIN = {{ region.origin_hex }}, LENGTH = {{ region.length_hex }}{% endfor %}
}

SECTIONS
{
  .isr_vector :
  {
    KEEP(*(.isr_vector))
  } > {{ flash_region }}

  .text :
  {
    *(.text*)
    *(.rodata*)
    KEEP(*(.init))
    KEEP(*(.fini))
    . = ALIGN(4);
    _etext = .;
  } > {{ flash_region }}
{%- if runtime_initialization %}

  .preinit_array :
  {
    PROVIDE_HIDDEN(__preinit_array_start = .);
    KEEP(*(.preinit_array*))
    PROVIDE_HIDDEN(__preinit_array_end = .);
  } > {{ flash_region }}

  .init_array :
  {
    PROVIDE_HIDDEN(__init_array_start = .);
    KEEP(*(SORT(.init_array.*)))
    KEEP(*(.init_array*))
    PROVIDE_HIDDEN(__init_array_end = .);
  } > {{ flash_region }}

  .fini_array :
  {
    PROVIDE_HIDDEN(__fini_array_start = .);
    KEEP(*(SORT(.fini_array.*)))
    KEEP(*(.fini_array*))
    PROVIDE_HIDDEN(__fini_array_end = .);
  } > {{ flash_region }}
{%- endif %}

  .ARM.extab :
  {
    *(.ARM.extab* .gnu.linkonce.arm.extab.*)
  } > {{ flash_region }}

  .ARM.exidx :
  {
    *(.ARM.exidx* .gnu.linkonce.arm.exidx.*)
  } > {{ flash_region }}
{%- for section in fixed_sections %}

  {{ section.name }} {{ section.address_hex }} (NOLOAD) :
  {
    KEEP(*({{ section.name }}))
  } > {{ section.region }}{% endfor %}

  .data :
  {
    _sdata = .;
    *(.data*)
    . = ALIGN(4);
    _edata = .;
  } > {{ ram_region }} AT> {{ flash_region }}
  _sidata = LOADADDR(.data);

  .bss :
  {
    _sbss = .;
    *(.bss*)
    *(COMMON)
    . = ALIGN(4);
    _ebss = .;
  } > {{ ram_region }}

  .heap (NOLOAD) :
  {
    . = ALIGN(8);
    __end__ = .;
    end = __end__;
    __HeapBase = .;
    . += _Min_Heap_Size;
    __HeapLimit = .;
  } > {{ ram_region }}

  .stack (NOLOAD) :
  {
    . = ALIGN(8);
    __StackLimit = .;
    . += _Min_Stack_Size;
    __StackTop = .;
{%- if runtime_initialization %}
    __initial_sp = __StackTop;
    __heap_base = __HeapBase;
    __heap_limit = __HeapLimit;
{%- endif %}
  } > {{ ram_region }}
}
