<?xml version="1.0" encoding="UTF-8" ?>
<Project xmlns="http://www.keil.com/project">
  <Targets>
    <Target>
      <TargetName>Legacy</TargetName>
      <ToolsetNumber>0x4</ToolsetNumber>
      <ToolsetName>ARM-ADS</ToolsetName>
      <pCCUsed>5060750::V5.06 update 7 (build 750)::ARMCC</pCCUsed>
      <uAC6>0</uAC6>
      <TargetOption>
        <TargetCommonOption>
          <Device>STM32F429ZGTx</Device>
          <Vendor>STMicroelectronics</Vendor>
          <PackID>Keil.STM32F4xx_DFP.2.16.1</PackID>
          <Cpu>IRAM(0x20000000,0x30000) IROM(0x8000000,0x100000) CPUTYPE("Cortex-M4") CLOCK(168000000) FPU2</Cpu>
          <uFloatingPoint>1</uFloatingPoint>
        </TargetCommonOption>
        <OutputDirectory>.\Objects\</OutputDirectory>
        <OutputName>legacy</OutputName>
        <ListingPath>.\Listing\</ListingPath>
        <TargetArmAds>
          <Cads>
            <VariousControls>
              <MiscControls></MiscControls>
              <Define>USE_STDPERIPH_DRIVER,STM32F429xx</Define>
              <Undefine></Undefine>
              <IncludePath>Common;Main;Startup</IncludePath>
            </VariousControls>
          </Cads>
          <LDads>
            <VariousControls>
              <MiscControls></MiscControls>
              <ImageEntryPoint></ImageEntryPoint>
              <ScatterFile>.\Objects\legacy.sct</ScatterFile>
            </VariousControls>
          </LDads>
        </TargetArmAds>
      </TargetOption>
      <Groups>
        <Group>
          <GroupName>Common</GroupName>
          <Files>
            <File>
              <FileName>common.c</FileName>
              <FileType>1</FileType>
              <FilePath>.\Common\common.c</FilePath>
            </File>
          </Files>
        </Group>
        <Group>
          <GroupName>Main</GroupName>
          <GroupOption>
            <GroupArmAds>
              <Cads>
                <VariousControls>
                  <MiscControls></MiscControls>
                  <Define>MAIN_GROUP_DEF</Define>
                  <Undefine></Undefine>
                  <IncludePath></IncludePath>
                </VariousControls>
              </Cads>
            </GroupArmAds>
          </GroupOption>
          <Files>
            <File>
              <FileName>main.c</FileName>
              <FileType>1</FileType>
              <FilePath>.\Main\main.c</FilePath>
              <FileOption>
                <FileArmAds>
                  <Cads>
                    <VariousControls>
                      <MiscControls></MiscControls>
                      <Define>MAIN_FILE_DEF</Define>
                      <Undefine></Undefine>
                      <IncludePath></IncludePath>
                    </VariousControls>
                  </Cads>
                </FileArmAds>
              </FileOption>
            </File>
            <File>
              <FileName>startup_stm32f4xx.s</FileName>
              <FileType>2</FileType>
              <FilePath>.\Startup\startup_stm32f4xx.s</FilePath>
            </File>
          </Files>
        </Group>
      </Groups>
    </Target>
  </Targets>
</Project>
